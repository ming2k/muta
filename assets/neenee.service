# neenee session daemon — systemd *user* unit (ADR-0101 deployment option).
#
# Install:
#   cp neenee.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now neenee
#
# Notes:
# - `--idle-exit 0` disables idle auto-exit: a supervised daemon should live
#   as long as the unit (ADR-0100 alternative B — an option, never the
#   default posture).
# - `--grace 20` > `TimeoutStopSec=15`: the daemon's own budget expires
#   first, so its forced-exit path (which still fires what it can and
#   removes its discovery record) wins the race with systemd's SIGKILL.
# - Enable lingering so the daemon survives logout when you want cron-
#   scheduled prompts to keep running:
#     loginctl enable-linger $USER
# - The Type is `exec` (not `notify`): the daemon does not speak sd_notify;
#   readiness is observed through the discovery record / `neenee status`.

[Unit]
Description=neenee session daemon
Documentation=https://github.com/ming2k/neenee
After=network.target

[Service]
Type=exec
ExecStart=%h/.local/bin/neenee serve --idle-exit 0 --grace 20
Restart=on-failure
RestartSec=2
# Graceful stop: SIGTERM starts the daemon's drain; give it its full budget
# before the supervisor escalates.
KillSignal=SIGTERM
TimeoutStopSec=25
# Hardening (per-user service):
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/neenee %h/.local/share/neenee %h/.cache/neenee

[Install]
WantedBy=default.target
